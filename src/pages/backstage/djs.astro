---
import AdminLayout from '../../layouts/admin-layout.astro'
---
<AdminLayout>
    <main id="dj-directory" data-api={import.meta.env.PUBLIC_DESK_API_URL || ''}>
        <header class="directory-heading">
            <div><p class="eyebrow">JETTY BACKSTAGE</p><h1>DJs &amp; shows</h1>
                <p class="intro">The people, programs, and details behind the schedule.</p></div>
            <a class="btn btn-outline" href="/schedule/">View calendar</a>
        </header>
        <div class="overview" aria-label="Schedule overview" hidden>
            <div><strong id="dj-artist-total"></strong><span>scheduled DJs / acts</span></div>
            <div><strong id="dj-show-total"></strong><span>scheduled shows</span></div>
            <div><strong id="dj-paused-total"></strong><span>paused shows</span></div>
        </div>
        <p class="source-note">From the submitted roster. Official slots are shown separately from scheduling requests; this directory does not sync with the live calendar.</p>
        <form class="directory-filters" role="search">
            <label for="dj-search">Find a DJ or show
                <input class="input" id="dj-search" type="search" placeholder="Artist, show, contact, or organizer" disabled />
            </label>
            <label for="dj-status">Show status
                <select class="select" id="dj-status" disabled>
                    <option value="scheduled">On the schedule</option><option value="paused">Paused</option>
                    <option value="other">Other submissions</option><option value="all">All submissions</option>
                </select>
            </label>
            <button id="dj-refresh" class="btn btn-outline" type="button" disabled>Refresh</button>
        </form>
        <p id="dj-count" role="status" aria-live="polite">Sign in to load the DJ directory.</p>
        <section class="directory-list" aria-label="DJ and show directory"></section>
        <p id="dj-empty" class="notice" hidden>No shows match. Try another name or choose “All submissions”.</p>
        <noscript><p class="notice">Enable JavaScript to sign in and load the private DJ directory.</p></noscript>
    </main>
</AdminLayout>
<script>
    import '../../lib/backstage/directory-client'
</script>
<style is:global>
#dj-directory{max-width:1260px;margin:32px auto 80px;padding:0 24px;color:#f2f2f2;font-size:1rem;line-height:1.6}#dj-directory .directory-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:28px}#dj-directory .eyebrow{font-size:.875rem;letter-spacing:.12em;color:#c8e6a0;margin-bottom:8px}#dj-directory h1{font:600 2.5rem Georgia,serif;margin-bottom:12px;line-height:1.15}#dj-directory .intro,#dj-directory .source-note{color:#ccc}#dj-directory .source-note{font-size:.875rem;margin:16px 0 28px;max-width:850px}#dj-directory .overview{display:flex;flex-wrap:wrap;border-block:1px solid #ffffff36;background:#161616eb}#dj-directory .overview>div{display:flex;gap:12px;align-items:baseline;padding:20px 24px;flex:1;min-width:220px}#dj-directory .overview strong{font:500 2rem Georgia,serif;color:#c8e6a0}#dj-directory .overview span{font-size:.875rem;color:#ddd}#dj-directory .directory-filters{display:flex;gap:16px;align-items:end;flex-wrap:wrap}#dj-directory label{display:flex;flex-direction:column;gap:8px;flex:1;min-width:200px;font-size:.875rem}#dj-directory label:first-child{flex:2}#dj-directory input,#dj-directory select{width:100%;background:#f7f5ef;color:#181818;color-scheme:light;font-size:1rem}#dj-directory input::placeholder{color:#69665f}#dj-directory #dj-count{margin:24px 0 12px;color:#ccc;font-size:.875rem}#dj-directory .directory-list{border-top:1px solid #ffffff36}#dj-directory .dj-record{background:#161616eb;border:1px solid #ffffff36;border-top:0}#dj-directory summary{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,.6fr) 20px;gap:20px;align-items:center;padding:22px 24px;cursor:pointer;list-style:none}#dj-directory summary::-webkit-details-marker{display:none}#dj-directory summary:hover{background:#ffffff08}#dj-directory summary:focus-visible{outline:2px solid #c8e6a0;outline-offset:-3px}#dj-directory .artist h2{font-size:1.125rem;font-weight:600;line-height:1.5;overflow-wrap:anywhere}#dj-directory .artist>span{color:#ccc;display:block;overflow-wrap:anywhere}#dj-directory .slot{display:flex;flex-direction:column}#dj-directory .slot small{color:#bcbcbc;font-size:.875rem}#dj-directory .status-label{font-size:.875rem;color:#ddd;overflow-wrap:anywhere}#dj-directory .status-label.scheduled{color:#c8e6a0}#dj-directory .expand{font-size:1.5rem;color:#c8e6a0}#dj-directory details[open] .expand{transform:rotate(45deg)}#dj-directory .record-details{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;padding:28px 24px;border-top:1px solid #ffffff26}#dj-directory h3{font:600 1.25rem Georgia,serif;color:#c8e6a0;margin-bottom:24px}#dj-directory dl>div+div{margin-top:20px}#dj-directory dt{font-size:.875rem;color:#bbb;margin-bottom:4px}#dj-directory dd{overflow-wrap:anywhere;white-space:pre-wrap}#dj-directory .missing{color:#aaa;font-style:italic}#dj-directory .record-details a{color:#c8e6a0;text-decoration:underline;text-underline-offset:3px}#dj-directory .notice{padding:24px;background:#161616eb;border:1px solid #ffffff36;margin-top:24px}#dj-directory .notice h2{font-size:1.25rem}#dj-directory .notice .btn{margin-top:16px}#dj-directory .btn-outline{color:#f2f2f2;border-color:#aaa89f}#dj-directory .btn-outline:hover{color:#172210;background:#c8e6a0}#dj-directory [hidden]{display:none!important}
    @media(max-width:900px){#dj-directory summary{grid-template-columns:minmax(0,1fr) minmax(0,1fr) 20px}#dj-directory .status-label{grid-column:1 / 3;grid-row:2}#dj-directory .expand{grid-column:3;grid-row:1}#dj-directory .record-details{grid-template-columns:1fr;gap:32px}#dj-directory .record-details section+section{border-top:1px solid #ffffff26;padding-top:24px}}
    @media(max-width:520px){#dj-directory{padding:0 16px}#dj-directory .directory-heading{align-items:flex-start;flex-direction:column}#dj-directory h1{font-size:2rem}#dj-directory summary{padding:18px 16px;grid-template-columns:minmax(0,1fr) 20px;gap:12px}#dj-directory .slot{grid-column:1;grid-row:2}#dj-directory .status-label{grid-column:1;grid-row:3}#dj-directory .expand{grid-column:2;grid-row:1}#dj-directory .record-details{padding:24px 16px}#dj-directory .directory-filters>label{min-width:100%;}#dj-directory .overview>div{padding:12px 16px}}

</style>
