---
import AdminLayout from '../../layouts/admin-layout.astro'
import logo from '../../assets/jettyradio2.png'
---
<AdminLayout>
 <main id="desk" class="desk" data-api={import.meta.env.PUBLIC_DESK_API_URL || ''}>
  <header class="desk-heading"><img src={logo.src} alt="Jetty Radio" width="230"/><div><p class="desk-kicker">BACKSTAGE 𒀭 PROGRAMMING</p><h1>Scheduling Desk</h1><p>Review this week’s episodes and schedule them in AzuraCast.</p></div></header>
  <div class="desk-toolbar"><div class="desk-week-navigation"><label>Week beginning <input id="desk-week" class="input input-bordered" type="date" required/></label><button id="desk-previous-week" type="button" class="btn btn-outline" aria-label="Previous week" title="Previous week">←</button><button id="desk-next-week" type="button" class="btn btn-outline" aria-label="Next week" title="Next week">→</button></div><span>Pacific time · America/Los_Angeles</span><button id="desk-add" class="btn btn-accent" disabled>Add episode</button></div>
  <p id="desk-status" role="status" aria-live="polite">Connecting to the desk…</p>
  <div class="desk-columns"><section class="desk-panel" aria-labelledby="week-heading"><div class="desk-section-heading"><h2 id="week-heading">This week</h2><span id="desk-count"></span></div><p id="desk-summary" class="desk-small"></p><div id="desk-shows"></div></section><aside class="desk-panel desk-resources"><h2>Submission sources</h2><a class="link" href="https://docs.google.com/spreadsheets/d/1JWANaTg7HKQzrEQyqv1Y5ksioj-4sqUfu6-IBRDjwXw/edit" target="_blank" rel="noreferrer">Episode responses ↗</a><a class="link" href="/schedule" target="_blank" rel="noreferrer">Published calendar ↗</a><a class="link" href="https://stream.jettyradio.com/dashboard" target="_blank" rel="noreferrer">Open AzuraCast ↗</a></aside></div>
  <dialog id="desk-editor" class="modal"><div class="modal-box desk-editor">
   <div class="desk-section-heading"><div><p class="desk-kicker">EPISODE SCHEDULING</p><h2 id="editor-heading">Review episode</h2></div><button id="desk-close" type="button" class="btn btn-ghost" aria-label="Close episode review">✕</button></div>
   <form id="desk-form">
    <fieldset class="desk-step"><legend>1. Confirm air date and time</legend><p class="desk-small">Check this episode against the published calendar and confirm any changes with the resident.</p><div class="desk-fields"><label>Air date<input name="date" type="date" class="input" required/></label><label>Assigned scheduler<input name="owner" class="input" maxlength="1000"/></label><label>Start time · Pacific<input name="start" type="time" class="input" required/></label><label>End time · Pacific<input name="end" type="time" class="input" required/></label></div><label class="desk-check"><input name="dateConfirmed" type="checkbox" class="checkbox"/>Air date and time confirmed</label></fieldset>
    <fieldset class="desk-step"><legend>2. Listen and check artwork</legend><div class="desk-fields"><label>Show name<input name="title" class="input" required maxlength="1000"/></label><label>Artist name<input name="artist" class="input" required maxlength="1000"/></label></div><label>Episode MP3 link<input name="audio" type="url" class="input" placeholder="https://drive.google.com/…"/></label><a id="desk-audio-link" class="link" target="_blank" rel="noreferrer" hidden>Open episode audio ↗</a><div id="desk-art-drop" class="desk-art-drop" role="group" aria-label="Episode artwork"><p>Drop album art here</p><button id="desk-art-choose" type="button" class="btn btn-outline">Choose image</button><input id="desk-art-file" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" aria-label="Album artwork image" hidden/><img id="desk-art-preview" class="desk-art-preview" alt="Selected episode artwork preview" hidden/><button id="desk-art-remove" type="button" class="btn btn-ghost" hidden>Remove selected image</button></div><p id="desk-art-status" class="desk-small" role="status" aria-live="polite"></p><details><summary>Use an artwork link instead</summary><label>Episode artwork link<input name="art" type="url" class="input" placeholder="https://drive.google.com/…"/></label><a id="desk-art-link" class="link" target="_blank" rel="noreferrer" hidden>Open episode artwork ↗</a><p class="desk-small">Link imports require a directly downloadable Drive JPEG or PNG. A selected image takes priority.</p></details><label>Episode tracklist<textarea name="tracklist" class="textarea" rows="5" maxlength="20000" placeholder="Tracks in playing order"></textarea></label><label class="desk-check"><input name="audioReviewed" type="checkbox" class="checkbox"/>Listened to the full MP3; duration, playback, and clipping checked</label><label class="desk-check"><input name="artReviewed" type="checkbox" class="checkbox"/>Artwork checked for the correct show, date, time, and information</label><label>Internal scheduling notes<textarea name="notes" class="textarea" rows="3" maxlength="5000"></textarea></label></fieldset>
    <fieldset class="desk-step"><legend>3. Upload this episode to AzuraCast</legend><p class="desk-small">Transfer the MP3 directly from Google Drive to AzuraCast—no download to your computer needed. You can upload before completing the review checks; those are required to schedule in step 4.</p><label>MP3 name in AzuraCast<input name="uploadName" class="input" maxlength="176" required aria-describedby="desk-filename" placeholder="Show name - YYYY-MM-DD"/></label><p class="desk-small">Choose a name you’ll recognize in AzuraCast. A unique suffix prevents duplicate uploads from replacing each other.</p><p id="desk-filename" class="desk-small desk-filename"></p><p id="desk-media" class="desk-audio-summary" role="status">Episode audio hasn’t been uploaded yet.</p><button id="desk-import" type="button" class="btn btn-outline">Upload MP3 from episode link</button><details><summary>Upload the linked MP3 from this computer</summary><p class="desk-small">If Drive asks you to sign in, download the MP3 from the episode link and choose it here.</p><input id="desk-upload-file" type="file" accept=".mp3,audio/mpeg" class="file-input" aria-label="Downloaded episode MP3"/><button id="desk-upload" type="button" class="btn btn-outline" disabled>Upload episode MP3</button></details><p id="desk-import-status" role="status" aria-live="polite"></p></fieldset>
    <fieldset class="desk-step"><legend>4. Schedule the episode</legend><button id="desk-connect" type="button" class="btn btn-outline">Find show in AzuraCast</button><div id="desk-station" hidden><label>Show playlist<select id="desk-playlist" class="select"><option value="">Choose this show's playlist</option></select></label><label>Show audio folder<select id="desk-directory" class="select"><option value="">Choose this show's folder</option></select></label></div><p class="desk-small">Choose the existing playlist and folder for this show. Scheduling saves the episode details and artwork, moves the MP3 into the show folder, and enables the playlist for the confirmed time.</p><p id="desk-station-status" role="status" aria-live="polite"></p><button id="desk-schedule" type="submit" class="btn btn-accent" disabled>Schedule in AzuraCast</button><p id="desk-form-status" role="status" aria-live="polite"></p><details><summary>After scheduling and airing</summary><p class="desk-small">Once scheduled, mark the episode response “scheduled” with your name and send the resident a confirmation.</p></details></fieldset>
    <fieldset id="desk-archive-section" class="desk-step"><legend>After show airs</legend><p class="desk-small">Add this episode to Archives and heavy rotation, remove it from its show playlist, and disable that playlist. The air date is checked and saved as MM/DD/YYYY.</p><p id="desk-archive-summary" class="desk-small"></p><button id="desk-archive" type="button" class="btn btn-outline" disabled>Archive episode</button><p id="desk-archive-status" role="status" aria-live="polite"></p></fieldset>
    <button id="desk-save" type="button" class="btn btn-ghost">Save draft for later</button>
   </form>
  </div></dialog>
 </main>
</AdminLayout>
<script>import '../../lib/desk/client'</script>
<style>
 .desk-week-navigation{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px}
 .desk{max-width:1260px;margin:32px auto 80px;padding:0 24px;font-size:16px;color:#f2f2f2}.desk-heading{display:flex;align-items:center;gap:40px;margin-bottom:32px}.desk-heading img{max-width:230px;height:auto}.desk-heading h1{font:600 2.5rem Georgia,serif;line-height:1.15;margin:8px 0 12px}.desk-heading p{color:#ccc}.desk-kicker{font-size:.75rem;letter-spacing:.15em}.desk-toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin:24px 0}.desk-toolbar label{display:flex;align-items:center;gap:12px}.desk-toolbar>span{display:flex;align-items:center;min-height:40px;font-size:.875rem;color:#ccc;margin-right:auto}.desk input,.desk textarea,.desk select{width:100%;color:#181818;background:#f7f5ef;border-color:#aaa89f;color-scheme:light}.desk input::placeholder,.desk textarea::placeholder{color:#69665f;opacity:1}.desk select option{color:#181818;background:#f7f5ef}.desk input:focus-visible,.desk textarea:focus-visible,.desk select:focus-visible{outline:2px solid #c8e6a0;outline-offset:3px}.desk input[type=checkbox]{background:#f7f5ef;color:#182410;accent-color:#c8e6a0}.desk input:disabled,.desk textarea:disabled,.desk select:disabled{color:#625f58;opacity:1}.desk input::file-selector-button{color:#181818;background:#e2dfd5}.desk-toolbar input{width:170px}.desk-columns{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:24px}.desk-panel{background:#161616eb;border:1px solid #ffffff36;padding:24px;border-radius:6px}.desk h2{font:600 1.65rem Georgia,serif}.desk h3{font:600 1.25rem Georgia,serif;margin-bottom:12px}.desk-section-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:20px}.desk-resources{height:fit-content}.desk-resources p{line-height:1.7;color:#ccc;margin:16px 0}.desk-resources a{display:block;margin:16px 0}.desk hr{border-color:#ffffff36;margin:24px 0}.desk-small{font-size:.875rem;line-height:1.6;color:#bbb}.desk-editor{max-width:720px;background:#191919;color:#f2f2f2;border:1px solid #ffffff40}.desk form,#desk-station{display:flex;flex-direction:column;gap:18px}.desk #desk-station[hidden]{display:none}.desk label{display:flex;flex-direction:column;gap:8px;font-size:.875rem}.desk-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.desk-step{display:flex;flex-direction:column;gap:16px;margin-top:12px}.desk-step legend{font:600 1.15rem Georgia,serif}.desk-art-drop{border:2px dashed #aaa89f;border-radius:6px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;background:#222}.desk-art-drop.desk-dragging{border-color:#c8e6a0;background:#293420}.desk-art-preview{max-width:100%;max-height:320px;object-fit:contain;border-radius:4px}.desk-art-drop [hidden]{display:none}.desk-filename,.desk-audio-summary{overflow-wrap:anywhere}.desk-audio-summary{padding:12px;border:1px solid #ffffff36;background:#222}.desk .btn:disabled{background:#333;color:#bcbcbc;border-color:#666;opacity:1}.desk details summary{cursor:pointer;text-decoration:underline}.desk details .btn{margin-top:12px}.desk fieldset{border:1px solid #ffffff36;padding:16px}.desk legend{padding:0 8px}.desk .desk-check{flex-direction:row;align-items:center;margin:10px 0;line-height:1.5}.desk-check input{width:24px}.desk [role=status]{margin:16px 0;line-height:1.6}.desk :global(.desk-row){width:100%;display:grid;grid-template-columns:100px 1fr auto;gap:16px;align-items:center;text-align:left;padding:20px 0;border-bottom:1px solid #ffffff26;cursor:pointer}.desk :global(.desk-row:hover){background:#ffffff08}.desk :global(.desk-row time){font:14px monospace;color:#ccc}.desk :global(.desk-row strong){display:block;font:600 1.15rem Georgia,serif}.desk :global(.desk-row small){display:block;font-size:14px;color:#bbb;margin-top:6px}.desk :global(.desk-badge){font-size:14px;border:1px solid #ffffff40;padding:5px 10px;border-radius:4px}.desk :global(.desk-row:focus-visible){outline:2px solid currentColor;outline-offset:5px}.desk :global(.desk-error){color:#ffafa7}.desk :global(.desk-success){color:#a8e8c5}@media(max-width:850px){.desk-columns{grid-template-columns:1fr}.desk-heading{gap:24px}.desk-heading img{width:160px}.desk :global(.desk-row){grid-template-columns:85px 1fr}.desk :global(.desk-badge){grid-column:2;width:fit-content}}@media(max-width:520px){.desk{padding:0 16px}.desk-heading{align-items:start;flex-direction:column}.desk-heading h1{font-size:2rem}.desk-fields{grid-template-columns:1fr}.desk-panel{padding:18px}.desk-toolbar label{width:100%}.desk-toolbar>span{width:100%}}
</style>
