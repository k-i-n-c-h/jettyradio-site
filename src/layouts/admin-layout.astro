---
import RootLayout from './root-layout.astro'
import { Show, SignInButton } from '@clerk/astro/components'
import Header from '../components/header.astro'
---

<RootLayout title="Jetty Admin">
    <Header backstage />
    <div class="backstage-shell">
        <Show when="signed-in">
            <div class="backstage-content"><slot /></div>
        </Show>
        <Show when="signed-out">
            <div class="hero min-h-screen">
                <div class="hero-content text-center">
                    <div class="max-w-md">
                        <h1 class="text-5xl font-bold">Jetty Backstage</h1>
                        <p class="py-6">
                            Ohhhhhhhh you found it! Very much under development, be
                            careful 😘
                        </p>
                        <SignInButton mode="modal" class:list="btn btn-primary" />
                    </div>
                </div>
            </div>
        </Show>
    </div>
</RootLayout>

<style is:global>
    .backstage-shell{--backstage-font:"Courier New",Courier,monospace;font-family:var(--backstage-font)}
    .backstage-shell button,.backstage-shell input,.backstage-shell select,.backstage-shell textarea{font-family:inherit}
    .backstage-content h1,.backstage-content h2,.backstage-content h3{font-family:var(--backstage-font)}
    .backstage-content .btn{border-radius:2px}
    .backstage-content .input,.backstage-content .select,.backstage-content .textarea,.backstage-content .file-input{border-radius:2px}
    .backstage-content .desk-panel,.backstage-content .table-container,.backstage-content .dj-record,.backstage-content .notice{border-radius:2px}
</style>
