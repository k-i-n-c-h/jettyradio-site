---
import logo from "../assets/jettyradio2.png";
import { Show, UserButton } from '@clerk/astro/components';

interface Props { backstage?: boolean }
const { backstage = false } = Astro.props;
---

<style>
    header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 16px;
        font-family: serif;
    }

    nav {
        text-align: center;
        font-family: serif;
        font-size: 18px;
        line-height: 2;
    }

    .subtitle {
        font-size: 16px;
    }

    .account {
        display: flex;
        justify-content: center;
        margin-top: 8px;
    }

    .logo img {
        max-width: 312px;
        height: auto;
        display: block;
        margin: 0;
    }

    .logo {
        display: flex;
        justify-content: center;
    }
</style>
<header>
    <a href="/" class="logo"><img src={logo.src} alt="Jetty Radio" /></a>
    <p class="subtitle">Santa Cruz-based internet radio</p>
</header>
<nav aria-label="Jetty navigation">
    <a class="link" href="/">Listen Live</a> 𒀭
    <a class="link" href="/schedule">Schedule</a> 𒀭
    <a class="link" href="/archive">Archives</a> 𒀭
    <a class="link" href="/about">About</a>
    <br />
    <a class="link" href="/support">Support</a> 𒀭
    <a class="link" href="https://instagram.com/jettyradio" target="_blank"
        >Instagram</a
    >
    {backstage && <>
        <br />
        <a class="link" href="/backstage/episodes">Episodes</a> 𒀭
        <a class="link" href="/backstage/djs">DJs</a> 𒀭
        <a class="link" href="/backstage/submissions">Recently submitted</a> 𒀭
        <a class="link" href="/backstage/desk">Scheduling Desk</a>
        <Show when="signed-in"><div class="account"><UserButton /></div></Show>
    </>}
</nav>
