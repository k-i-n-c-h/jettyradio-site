{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jettyradio-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "vars": {
    "ALLOWED_ORIGINS": "https://jettyradio.com",
    "CLERK_ISSUER": "https://clerk.jettyradio.com",
    "CLERK_ALLOWED_USER_IDS": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jettyradio-desk",
      "database_id": "4ec6f6c1-dbb0-4e8d-83df-48b4af13d105",
      "migrations_dir": "migrations",
    },
  ],
}
